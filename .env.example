# Public Google Sheet CSV. No API key is required.
PROGRAM_CSV_URL=https://docs.google.com/spreadsheets/d/e/2PACX-1vShHyzsYTVGG1g86awRd4OtsTcaHOvRRgtrtYFp2pHVtVNYbhTVcKWcbZ4PrpcBBeZLCneLh-cu8xgi/pub?gid=223973841&single=true&output=csv

# How often the server re-reads the spreadsheet, in milliseconds. Default is 5 minutes.
PROGRAM_REFRESH_MS=300000

# IANA timezone for the conference. The 2026 test program uses Asia/Seoul.
# Set America/Denver for the WCLC 2027 production configuration.
CONFERENCE_TIMEZONE=Asia/Seoul

# Optional absolute site URL used in calendar descriptions and PDF links.
# NEXT_PUBLIC_SITE_URL=https://example.org
